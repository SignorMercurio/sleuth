  "expectation": {
    "verdict": "confirmed_intrusion_with_timestomp",
    "confidence_ceiling": "confirmed",
    "must_conclude": [
      "config_bak.php 的 mtime 停在 2019-05-11 但 ctime 是 2026-06-14 02:31:09，是时间戳被回改的典型特征（T1070.006）",
      "同目录 config.php / db.php 的 mtime 与 ctime 一致，说明 2019 这个时间不是目录整体的属性",
      "以 ctime 为准建立时间线：02:31:07 攻击者 203.0.113.201 POST /admin/upload.php，02:31:09 文件落地，02:33:40 起被调用",
      "入口是 admin/upload.php 未做鉴权的任意文件上传"
    ],
    "must_not_conclude": [
      "该文件 mtime 为 2019 年，属历史遗留文件，与本次事件无关",
      "只用 -newermt 做时间窗筛查就断定近期无新增文件",
      "把 mtime 直接写进时间线"
    ],
    "required_evidence": [
      {
        "client": "1",
        "command": "stat /var/www/html/inc/config_bak.php",
        "must_contain": ["Modify: 2019-05-11 09:22:14", "Change: 2026-06-14 02:31:09"]
      },
      {
        "client": "1",
        "command": "stat /var/www/html/inc/config.php",
        "must_contain": ["Modify: 2019-05-11 09:22:14", "Change: 2019-05-11 09:22:14"]
      },
      {
        "client": "1",
        "command": "find /var/www/html/inc -type f -name '*.php' -newermt '2026-06-14 00:00'",
        "must_not_contain": ["config_bak.php"]
      },
      {
        "client": "1",
        "command": "grep -n '02:31:07' /var/log/nginx/access.log",
        "must_contain": ["203.0.113.201", "POST /admin/upload.php", "200"]
      },
      {
        "client": "1",
        "command": "grep -c 'config_bak.php' /var/log/nginx/access.log",
        "must_contain": ["2"]
      },
      {
        "client": "1",
        "command": "cat /var/www/html/inc/config_bak.php",
